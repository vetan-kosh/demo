[Unit]
Description=VetanKosh FastAPI
After=network.target postgresql.service
[Service]
User=vetankosh
WorkingDirectory=/opt/vetankosh/backend
EnvironmentFile=/opt/vetankosh/backend/.env
ExecStart=/opt/vetankosh/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
MemoryMax=1200M
[Install]
WantedBy=multi-user.target
